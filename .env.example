# Copy to .env.local and fill in. Never commit .env.local.

# Anthropic — read ONLY in src/lib/claude.ts, never exposed to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# Supabase. Note there is no anon key here: this app does not use Supabase Auth,
# so the service-role key is the only database credential and it stays server-side.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# The single shared password that unlocks the app.
APP_PASSWORD=choose-something-long

# Random secret used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
