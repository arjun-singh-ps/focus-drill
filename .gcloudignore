# Controls what gcloud uploads to Cloud Build for `gcloud run deploy --source .`
# — a separate step from the Docker build, so .dockerignore alone isn't enough.
# Explicit rather than relying on gcloud's auto-generated-from-.gitignore
# behavior, since this directory sits right next to real secrets in .env.local.

.git
.gcloudignore

node_modules/
.next/
out/
build/

.env
.env.local
.env*.local

.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*

.vercel
.vscode
next-env.d.ts
*.tsbuildinfo

tests/
*.test.ts
